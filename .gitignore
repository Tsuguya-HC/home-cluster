# Secrets
*.sops.yaml

# Editor
.vscode/
*.swp

# Node
node_modules/

# Claude Code worktrees live inside the repo and are untracked, so `git add -A`
# stages them as an embedded gitlink instead of ignoring them.
.claude/worktrees/

# Python
__pycache__/

# kustomize --enable-helm は helmCharts のチャートをこの下に展開する。ビルド生成物で、
# ArgoCD の repo-server は自分で pull するのでコミットしない。
kustomize/*/charts/
